{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "model-deployer values",
  "type": "object",
  "additionalProperties": false,
  "required": ["model"],
  "definitions": {
    "quantity": {"type": ["string", "integer", "number"]},
    "duration": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
    "dnsLabel": {"type": "string", "pattern": "^([a-z]([a-z0-9-]{0,61}[a-z0-9])?)?$"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "object", "additionalProperties": {"$ref": "#/definitions/quantity"}},
        "limits": {"type": "object", "additionalProperties": {"$ref": "#/definitions/quantity"}}
      }
    }
  },
  "properties": {
    "preset": {"type": "object", "description": "A preset's title and description; aigw-ui leaves it out of a deployment"},
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": {"type": "string"},
        "namespace": {"$ref": "#/definitions/dnsLabel"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uri"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
        "uri": {"type": "string", "minLength": 1},
        "objectName": {"$ref": "#/definitions/dnsLabel"},
        "revision": {"type": ["string", "number"]},
        "capacityPerInstance": {"type": ["string", "number"]},
        "maxModelLen": {"type": ["string", "integer"], "pattern": "^([1-9][0-9]*)?$"},
        "marketId": {"type": "string"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["download", "cache"]},
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {"$ref": "#/definitions/quantity"},
            "storageClass": {"type": "string"},
            "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"]}
          }
        },
        "initializerImage": {"type": "string", "minLength": 1},
        "downloadResources": {"$ref": "#/definitions/resources"},
        "downloadHome": {"type": "string"},
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {"type": "string"},
            "serviceAccountName": {"type": "string"}
          }
        }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"type": "string"},
        "replicas": {"type": "integer", "minimum": 0, "maximum": 1000},
        "args": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[^\\s'\"$`\\\\;&|<>(){}*?\\[\\]!#~]+$"}
        },
        "env": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"const": "VLLM_ADDITIONAL_ARGS"}},
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        },
        "resources": {"$ref": "#/definitions/resources"},
        "gpus": {"type": "integer", "minimum": 0, "maximum": 64},
        "gpuProduct": {"type": "string"},
        "tensorParallel": {"type": "integer", "minimum": 0, "maximum": 64},
        "dataParallel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ranks": {"type": "integer", "minimum": 0, "maximum": 64},
            "supervisorPort": {"type": "integer", "minimum": 1024, "maximum": 65535}
          }
        },
        "runtimeClassName": {"type": "string"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "rollout": {"type": "object"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "keepAliveSeconds": {"type": "integer", "minimum": 0},
        "shmSize": {"$ref": "#/definitions/quantity"},
        "kvCacheOffloading": {"type": "object"},
        "volumes": {"type": "array", "items": {"type": "object"}},
        "volumeMounts": {"type": "array", "items": {"type": "object"}},
        "startupSeconds": {"type": "integer", "minimum": 10}
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {"type": "object"},
        "custom": {"type": "boolean"},
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {"type": "number", "minimum": 0},
            "queue": {"type": "number", "minimum": 0},
            "kvCache": {"type": "number", "minimum": 0},
            "noHitLru": {"type": "number", "minimum": 0}
          }
        },
        "flowControl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "maxConcurrency": {"type": ["integer", "null"], "minimum": 1},
            "requestTTL": {"$ref": "#/definitions/duration"},
            "fairnessPolicy": {"enum": ["", "round-robin-fairness-policy"]},
            "negativeBandMaxRequests": {"type": "integer", "minimum": 0},
            "enableEviction": {"type": "boolean"}
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "peerListener": {"type": "string", "minLength": 1}
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallelRequests": {"type": "integer", "minimum": 0},
        "requestTimeout": {"$ref": "#/definitions/duration"},
        "healthRetries": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "objectives": {"type": "object", "propertyNames": {"not": {"const": "best-effort"}}, "additionalProperties": {"type": "integer", "minimum": -1000, "maximum": 1000}},
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "standardQueuedFor": {"$ref": "#/definitions/duration"}
      }
    }
  }
}
